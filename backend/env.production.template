# Production Environment Configuration
# Copy this file to .env.production and update with actual production values

# Database
DATABASE_URL="postgresql://user:password@host:5432/syntaxis_ai_prod"

# JWT Configuration - MUST be changed in production!
JWT_SECRET="CHANGE_THIS_TO_STRONG_RANDOM_STRING_MIN_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_STRING"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Server Configuration
PORT=3001
NODE_ENV=production

# Redis (optional - for caching and queues)
REDIS_URL="redis://redis-host:6379"

# Email Configuration
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER="your-email@example.com"
EMAIL_SMTP_PASSWORD="your-app-password"
EMAIL_FROM_ADDRESS="noreply@syntaxis.ai"
EMAIL_FROM_NAME="SyntaxisAI"

# Application URLs
APP_URL="https://your-domain.com"
FRONTEND_URL="https://your-domain.com"
API_BASE_URL="https://api.your-domain.com"

# Storage
UPLOAD_DIR="/var/app/uploads"
MAX_FILE_SIZE=104857600  # 100MB in bytes
STORAGE_BUCKET="syntaxis-ai-production"

# OCR API Keys (Production)
GOOGLE_VISION_API_KEY="your-production-google-vision-key"
AWS_ACCESS_KEY_ID="your-production-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-production-aws-secret"
AWS_REGION="us-east-1"

# Monitoring and Logging
LOG_LEVEL="warn"
SENTRY_DSN=""  # Optional: Add Sentry for error tracking

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN="https://your-domain.com"

# Security
COOKIE_SECURE=true
COOKIE_SAME_SITE="strict"
HELMET_CSP_ENABLED=true

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_TELEMETRY=false
ENABLE_DEBUG_LOGS=false
