{
  "name": "syntaxis-ai-backend",
  "version": "1.0.0",
  "description": "Backend for SyntaxisAI invoice processing service",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "clean": "rimraf dist",
    "lint:fix": "eslint . --ext .ts --fix",
    "test:coverage": "jest --coverage --silent",
    "typecheck": "tsc --noEmit --skipLibCheck --pretty false || true",
    "build": "tsc || true",
    "start": "node dist/index.js",
    "test": "jest --silent --forceExit --detectOpenHandles",
    "test:watch": "jest --watch --silent",
    "test:ci": "jest --config jest.ci.config.js",
    "test:unit": "jest --config jest.unit.config.js",
    "test:unit:watch": "jest --config jest.unit.config.js --watch",
    "test:dependencies": "jest --config jest.unit.config.js --testPathPattern=dependency-setup",
    "test:setup-utils": "jest --config jest.unit.config.js --testPathPattern=setup-dependencies",
    "test:integration": "jest --testPathPattern=src/__tests__/integration --silent",
    "test:auth": "jest --testPathPattern=src/__tests__/auth --silent",
    "test:extraction": "jest --testPathPattern=src/__tests__/extraction --silent",
    "test:processing": "jest --testPathPattern=src/__tests__/processing --silent",
    "test:e2e": "jest --config jest.e2e.config.js",
    "lint": "eslint . --ext .ts || true",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "setup:test": "node ../scripts/setup-test.js --workspace=backend",
    "test:db:migrate": "NODE_ENV=test npx prisma migrate deploy",
    "test:db:reset": "NODE_ENV=test npx prisma migrate reset --force",
    "validate:tdd": "node ../scripts/validate-tdd-compliance.js",
    "validate:coverage": "node ../scripts/validate-tdd-compliance.js",
    "validate:all": "npm run validate:tdd && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@google-cloud/vision": "^4.0.2",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.18.0",
    "@types/ws": "^8.18.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cron": "^4.3.3",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "readable-stream": "^3.6.2",
    "sharp": "^0.33.2",
    "syntaxis-ai": "file:..",
    "tesseract.js": "^5.0.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.18.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.9",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.20",
    "@types/pg": "^8.16.0",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.2.5",
    "prisma": "^5.22.0",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  }
}
