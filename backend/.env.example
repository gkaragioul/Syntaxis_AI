# SyntaxisAI Backend Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port for the server to listen on
PORT=3000

# Environment mode (development, test, production)
NODE_ENV=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL database connection URL
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syntaxis_ai

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis connection URL for caching and job queues
# Format: redis://host:port
REDIS_URL=redis://localhost:6379

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Secret key for JWT token signing (MUST be 32+ characters in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration time
JWT_EXPIRES_IN=24h

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP server configuration for sending emails
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@syntaxis.ai

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================
# Directory for uploaded files
UPLOADS_DIR=./uploads

# Temporary directory for processing
TEMP_DIR=./temp

# Maximum file size in bytes (default: 100MB)
MAX_FILE_SIZE=104857600

# Allowed file types (comma-separated MIME types)
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png

# Cloud storage bucket (for production)
STORAGE_BUCKET=your-storage-bucket-name

# =============================================================================
# OCR CONFIGURATION
# =============================================================================
# Number of OCR worker processes
OCR_WORKER_COUNT=2

# OCR processing timeout in milliseconds
OCR_WORKER_TIMEOUT=300000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log format (dev, combined, json)
LOG_FORMAT=combined

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# CORS origin for frontend
CORS_ORIGIN=http://localhost:5173

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Enable metrics collection
ENABLE_METRICS=false

# Metrics server port
METRICS_PORT=9090

# =============================================================================
# OCR CONFIGURATION (for 100% accuracy features)
# =============================================================================
# Google Vision API credentials
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/google-credentials.json
GOOGLE_VISION_API_KEY=your-google-vision-api-key

# OCR engine settings
OCR_DEFAULT_ENGINE=tesseract
OCR_CONFIDENCE_THRESHOLD=0.85

# =============================================================================
# AI EXTRACTION CONFIGURATION
# =============================================================================
# OpenAI API key (for AI-powered extraction)
OPENAI_API_KEY=your-openai-api-key
AI_EXTRACTION_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.90
AI_BUDGET_LIMIT=100

# =============================================================================
# VALIDATION SYSTEM CONFIGURATION
# =============================================================================
VALIDATION_ENABLED=true
HIGH_CONFIDENCE_THRESHOLD=0.95
LOW_CONFIDENCE_THRESHOLD=0.80
AUTO_APPROVAL_ENABLED=true

# =============================================================================
# PROCESSING QUEUE CONFIGURATION
# =============================================================================
QUEUE_CONCURRENCY=5
MAX_RETRY_ATTEMPTS=3
PROCESSING_TIMEOUT=300000

# =============================================================================
# HUMAN REVIEW SYSTEM CONFIGURATION
# =============================================================================
MANUAL_REVIEW_ENABLED=true
REVIEW_QUEUE_SIZE=100
AUTO_ASSIGN_REVIEWS=true
REVIEW_TIMEOUT=3600000
